# Etapa de build: Node + Angular CLI
FROM node:20-alpine AS build

WORKDIR /app

# Copiamos package.json primero para aprovechar la cache de capas de Docker
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copiamos el resto del código y compilamos
COPY . .
RUN npm run build -- --configuration production

# Etapa final: nginx sirve los ficheros estáticos compilados
FROM nginx:alpine

# Copiamos la configuración de nginx que gestiona el routing de Angular
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos los ficheros compilados por Angular
COPY --from=build /app/dist/carpinchill-frontend/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
